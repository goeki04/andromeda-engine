# Conan profile for building Andromeda on Linux with Clang.
#
# IMPORTANT: compiler.version must match your installed Clang major version.
# The value below is only a fallback - build.sh and the CI Linux job detect the
# installed clang and override it with -s/-s:b compiler.version=<detected>.
# If you run `conan install` by hand, pass the same override or edit the line
# below, otherwise Conan may fail to find matching prebuilt binaries.
# Check your version with:   clang --version
#
# build_type is passed on the command line (-s build_type=Debug/Release).

[settings]
os=Linux
arch=x86_64
compiler=clang
compiler.version=21
compiler.cppstd=20
compiler.libcxx=libstdc++11
# Default build_type. The host build_type is overridden per run with
# -s build_type=Debug/Release; this default is what the build context
# (tool_requires built from source, e.g. libxml2) uses, which must not be None.
build_type=Release

[options]
# The glslang 1.4.350.0 recipe fails to build its SPIR-V optimizer from source
# (missing spirv-tools include dirs). We don't need it, so disable everywhere
# (this profile is passed as both -pr and -pr:b).
glslang/*:enable_optimizer=False
# SDL pulls in pulseaudio on Linux, and pulseaudio asks for openssl/[>=1.1 <4] for its
# optional RAOP (AirPlay) sink - that conflicts with the openssl/4.x the engine requires.
# The engine does not need RAOP.
pulseaudio/*:with_openssl=False

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
# Force the Clang executables even if CC/CXX point elsewhere.
tools.build:compiler_executables={"c": "clang", "cpp": "clang++"}
# Let Conan install missing system packages (libudev-dev, libxcb-*, ...) via apt.
# Requires sudo; may prompt for your password on the first build.
tools.system.package_manager:mode=install
tools.system.package_manager:sudo=True
